rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each household lives under a long random code that only the invite link knows.
    // Listing households is not allowed, so the code can't be discovered.
    match /households/{hid}/{rest=**} {
      allow read, write: if hid.size() >= 20 && hid.size() <= 64;
    }
  }
}
